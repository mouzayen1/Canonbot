# Copy this file to `.env` and fill in your real Discord webhook URL.
# Create a webhook in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXX

# Optional: ping a role or @everyone on an in-stock hit. Leave blank for no ping.
# For a role, use the format <@&ROLE_ID>. For everyone, use @everyone.
DISCORD_MENTION=
