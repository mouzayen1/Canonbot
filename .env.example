# Copy this file to `.env` and fill in your real Discord webhook URL.
# Create a webhook in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXX

# Optional: ping a role or @everyone on an in-stock hit. Leave blank for no ping.
# For a role, use the format <@&ROLE_ID>. For everyone, use @everyone.
DISCORD_MENTION=

# Optional: bot display name + avatar shown on the alert (like "Trend Radar 2.0").
DISCORD_USERNAME=Canonbot 📷
DISCORD_AVATAR_URL=

# Optional: free Best Buy Developer API key (https://developer.bestbuy.com/).
# When set, Best Buy listings that include a `sku` in config.yaml are checked
# via the official API instead of scraping the page — far more reliable.
BESTBUY_API_KEY=

# Optional: Target's public web API key. A stable default is built in and rarely
# changes; only set this if Target starts returning errors (key rotated).
TARGET_API_KEY=
# Optional: Target fulfillment region (defaults shown). Affects the store used
# for the ship-to availability check; online stock is nationwide so defaults are fine.
# TARGET_STORE_ID=1234
# TARGET_ZIP=90210
# TARGET_STATE=CA

# Optional: override the Chromium binary used by browser mode. Usually unneeded;
# on a normal machine run `playwright install chromium` and leave this blank.
# CANONBOT_CHROMIUM=/usr/bin/chromium
